y = as.numeric(n_of_lm) / as.numeric(sgn_lengths),
color = perturbation)) +
stat_cor(method = "pearson",
aes(
x = as.numeric(Symbol_res),
y = as.numeric(n_of_lm) / as.numeric(sgn_lengths)))
scp
ggsave(
filename = "iLINCSres_lm_correlation.png", # Имя файла и формат
plot = scp,                                   # Какой объект графика сохранить
width = 8,                                        # Ширина (по умолчанию в дюймах)
height = 5,                                       # Высота (по умолчанию в дюймах)
units = "in",                                     # Единицы измерения (in, cm, mm, px)
dpi = 300                                         # Разрешение (только для растровых форматов типа PNG, JPEG)
)
